node_modules
dist
dist-ssr
*.local

# Env files — never commit keys. VITE_* vars are inlined into the public bundle.
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs / scratch output
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
build_error.txt
lint_output.txt

# Legacy cloud tooling (no longer used; see DECOMMISSION-CLOUD.md)
.vercel
.firebase
firebase-debug.log

# Self-hosted webfont binaries — fetched with `npm run fonts`, not committed
public/fonts/*.woff2

# Local SQLite database + backups (server/data lives outside git in production)
server/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# The one Basic Auth password, mounted into the container by
# deploy/docker-compose.yml. Bcrypt hash rather than plaintext, but it is still
# the only thing guarding the database — keep it out of the repo.
deploy/.htpasswd
.htpasswd

# Agent scratch
.kilo/
.claude/
