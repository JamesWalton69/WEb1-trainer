          "sets": 3,
          "reps": "15"
        },
        {
          "name": "Lunges",
          "sets": 3,
          "reps": "10 each leg"
        },
        {
          "name": "Pike push-ups",
          "sets": 3,
          "reps": "10"
        },
        {
          "name": "Mountain climbers",
          "sets": 3,
          "reps": "20"
        },
        {
          "name": "Plank",
          "sets": 3,
          "reps": "45 sec"
