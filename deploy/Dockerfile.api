# Dockerfile.api — the FitTrainer API for the compose stack.
#
# Bare metal is the primary path (deploy/fittrainer-api.service + systemd);
# DEPLOY.md documents that one first. This exists so the container option is a
# complete stack rather than a static site with a dead /api.
#
#   docker compose -f deploy/docker-compose.yml up -d --build
#
# Build context is the project root, so run it from there or use the compose
# file, which already sets `context: ..`.

# 22-alpine tracks Node 22 LTS. The floor is 22.13: node:sqlite exists from
# 22.5 but needed --experimental-sqlite until 22.13.
FROM node:22-alpine

WORKDIR /srv/fittrainer

# No npm install and no package.json copy on purpose — the server imports
# nothing but node: builtins. If that ever stops being true, this needs a
# package.json + `npm ci --omit=dev` layer above the COPY.
COPY server/ ./server/

ENV NODE_ENV=production \
    PORT=3001 \
    FITTRAINER_DB=/data/fittrainer.sqlite \
    NODE_OPTIONS=--disable-warning=ExperimentalWarning

# HOST is deliberately not set here, so a bare `docker run` binds loopback and
# stays private. The compose file sets HOST=0.0.0.0 because nginx reaches this
# over the compose network, and explains there why that is safe.

# Created and chowned before VOLUME so that when Docker initialises a fresh
# named volume it copies this ownership onto it. Without this the unprivileged
# user below cannot write, and the API dies on first start with EACCES.
RUN mkdir -p /data && chown node:node /data

# The database lives in a named volume, not the image. Without this a
# `docker compose down -v` would take the workout history with it.
VOLUME /data

# Drop root. node:alpine ships an unprivileged `node` user.
USER node

EXPOSE 3001

# Checks the process from inside its own container, so it stays honest even
# when nginx is the thing that is broken. /api/health needs no password: the
# password is enforced by nginx, not here.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/index.mjs"]
